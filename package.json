{
  "name": "contributorforge",
  "version": "0.3.0",
  "description": "Verified, reproducible contributor task bundles from GitHub issues",
  "type": "module",
  "bin": { "contributorforge": "dist/cli/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests examples",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts",
    "demo": "tsx examples/demo.ts",
    "demo:compare": "tsx examples/demo.ts --compare",
    "prepack": "pnpm build"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Gowrav-M/contributorforge.git" },
  "dependencies": { "commander": "^14.0.0", "yaml": "^2.8.1", "zod": "^4.1.12" },
  "devDependencies": { "@eslint/js": "^9.39.0", "@types/node": "^22.19.0", "eslint": "^9.39.0", "tsx": "^4.20.6", "typescript": "^5.9.3", "typescript-eslint": "^8.46.3", "vitest": "^3.2.4" }
}
